# apigw-cnl-cross -- API Gateway canal cross-cutting

# ── Servidor ──────────────────────────────────────────────
PORT=10601
NODE_ENV=development

# ── CORS ──────────────────────────────────────────────────
# Orígenes permitidos separados por coma
ALLOWED_ORIGINS=http://localhost:3000

# ── Rate Limiting ─────────────────────────────────────────
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
REQUEST_TIMEOUT=120000

# ── JWT (validación local — S6) ───────────────────────────
# Debe coincidir EXACTAMENTE con JWT_SECRET del auth service (ms-cnl-cross-auth-profile).
# El gateway valida el token localmente sin llamar al auth service.
# Ejemplo de cómo generarlo: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# ── Servicios proxiados ───────────────────────────────────
# URL del Auth Service — usada para PROXY de rutas /auth/*
AUTH_URL=https://host.docker.internal:20701
# MS Canal cross-cutting — PROXY de rutas /audit/*, /catalogs/* y /media/*
CNL_AUDIT_URL=https://host.docker.internal:20703
CNL_CATALOGS_URL=https://host.docker.internal:20704
CNL_MEDIA_URL=https://host.docker.internal:20702

# ── SSL ───────────────────────────────────────────────────
# USE_SSL=true activa el servidor HTTPS adicional en SSL_PORT
USE_SSL=true
SSL_PORT=20601
# Ruta donde están los certificados propios de este gateway (server.crt / server.key o server.pfx).
CERT_PATH=/app/certs
# Ruta HOST (docker-compose) del certificado autofirmado propio de este gateway, montado en CERT_PATH.
CERTS_HOST_PATH=../certs-dev

# CA de confianza para llamadas salientes (proxy) a MS internos autofirmados
# (AUTH_URL, CNL_AUDIT_URL, etc.). Debe apuntar SIEMPRE al certificado autofirmado
# compartido por los MS internos (certs-dev), incluso si CERT_PATH arriba ya es un
# certificado real — son dos certificados distintos con propósitos distintos.
INTERNAL_CA_PATH=/app/certs-internal
# Ruta HOST (docker-compose) del certificado autofirmado interno montado en INTERNAL_CA_PATH.
INTERNAL_CERTS_HOST_PATH=../certs-dev

# ── Kafka Audit Logger ────────────────────────────────────
# AUDIT_LOGGER_ENABLED=false desactiva el audit logger por completo:
# no se intenta conectar a Kafka y el logging se vuelve un no-op silencioso.
AUDIT_LOGGER_ENABLED=false
# Broker(s) Kafka separados por coma
KAFKA_BROKER=host.docker.internal:10403
# Topic al que este servicio publica eventos de gateway
KAFKA_TOPIC=platform.logs
